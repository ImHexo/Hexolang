import "stdlib/math.hexo" as math;
// Low-level 3D API exposed by the optional raylib backend.
let beginCameraNative = game3DBegin;
let endCamera = game3DEnd;
let drawCubeNative = game3DCube;
let drawSphereNative = game3DSphere;
let drawGridNative = game3DGrid;

fn beginCamera(position, target, up, fov) {
    return beginCameraNative(position[0], position[1], position[2],
        target[0], target[1], target[2], up[0], up[1], up[2], fov);
}
fn drawCube(position, size, color) {
    return drawCubeNative(position[0], position[1], position[2],
        size[0], size[1], size[2], color);
}
fn drawSphere(position, radius, color) {
    return drawSphereNative(position[0], position[1], position[2], radius, color);
}
fn drawGrid(slices, spacing = nil) {
    if (spacing == nil) { return drawGridNative(slices); }
    return drawGridNative(slices, spacing);
}

fn vec3(x, y, z) { return [x, y, z]; }
fn add(a, b) { return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]; }
fn subtract(a, b) { return [a[0] - b[0], a[1] - b[1], a[2] - b[2]]; }
fn scale(a, amount) { return [a[0] * amount, a[1] * amount, a[2] * amount]; }
fn dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
fn cross(a, b) {
    return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
}
fn length(a) { return sqrt(dot(a, a)); }
fn normalize(a) {
    let magnitude = length(a);
    if (magnitude == 0) { return [0, 0, 0]; }
    return scale(a, 1 / magnitude);
}
fn distance(a, b) { return length(subtract(a, b)); }
fn lerp(a, b, amount) { return add(a, scale(subtract(b, a), amount)); }

class Camera3D {
    fn init(position, target, up, fov) {
        this.position = position;
        this.target = target;
        this.up = up;
        this.fov = fov;
    }
    fn begin() { beginCamera(this.position, this.target, this.up, this.fov); }
    fn end() { endCamera(); }
}

fn distanceSquared(a, b) { let d = subtract(a, b); return dot(d, d); }
fn hadamard(a, b) { return [a[0] * b[0], a[1] * b[1], a[2] * b[2]]; }
fn rotateX(v, angle) {
    let c = math.cos(angle); let s = math.sin(angle);
    return [v[0], v[1] * c - v[2] * s, v[1] * s + v[2] * c];
}
fn rotateY(v, angle) {
    let c = math.cos(angle); let s = math.sin(angle);
    return [v[0] * c + v[2] * s, v[1], -v[0] * s + v[2] * c];
}
fn rotateZ(v, angle) {
    let c = math.cos(angle); let s = math.sin(angle);
    return [v[0] * c - v[1] * s, v[0] * s + v[1] * c, v[2]];
}
fn angleBetween(a, b) {
    let denominator = length(a) * length(b);
    if (denominator == 0) { return 0; }
    let cosine = dot(a, b) / denominator;
    if (cosine < -1) { cosine = -1; }
    if (cosine > 1) { cosine = 1; }
    return math.acos(cosine);
}
fn project(a, onto) {
    let denominator = dot(onto, onto);
    if (denominator == 0) { return [0, 0, 0]; }
    return scale(onto, dot(a, onto) / denominator);
}
fn reflect(vector, normal) {
    let unitNormal = normalize(normal);
    return subtract(vector, scale(unitNormal, 2 * dot(vector, unitNormal)));
}


let drawPlaneNative = game3DPlane;
let drawCubeWiresNative = game3DCubeWires;
let drawSphereWiresNative = game3DSphereWires;
let drawCylinderNative = game3DCylinder;
fn drawPlane(position, size, color) {
    return drawPlaneNative(position[0], position[1], position[2], size[0], size[1], color);
}
fn drawCubeWires(position, size, color) {
    return drawCubeWiresNative(position[0], position[1], position[2], size[0], size[1], size[2], color);
}
fn drawSphereWires(position, radius, rings, slices, color) {
    return drawSphereWiresNative(position[0], position[1], position[2], radius, rings, slices, color);
}
fn drawCylinder(position, radiusTop, radiusBottom, height, slices, color) {
    return drawCylinderNative(position[0], position[1], position[2], radiusTop, radiusBottom, height, slices, color);
}


let loadModel = game3DLoadModel;
let drawModelNative = game3DDrawModel;
let unloadModel = game3DUnloadModel;
fn drawModel(model, position, scale = 1, color = 0xffffff) {
    return drawModelNative(model, position[0], position[1], position[2], scale, color);
}

let drawModelExNative = game3DDrawModelEx;
let drawModelWiresNative = game3DDrawModelWires;
let drawModelWiresExNative = game3DDrawModelWiresEx;
fn drawModelEx(model, position, rotationAxis, rotationAngle, modelScale, color = 0xffffff) {
    return drawModelExNative(model, position[0], position[1], position[2],
        rotationAxis[0], rotationAxis[1], rotationAxis[2], rotationAngle,
        modelScale[0], modelScale[1], modelScale[2], color);
}
fn drawModelWires(model, position, modelScale = 1, color = 0xffffff) {
    return drawModelWiresNative(model, position[0], position[1], position[2], modelScale, color);
}
fn drawModelWiresEx(model, position, rotationAxis, rotationAngle, modelScale, color = 0xffffff) {
    return drawModelWiresExNative(model, position[0], position[1], position[2],
        rotationAxis[0], rotationAxis[1], rotationAxis[2], rotationAngle,
        modelScale[0], modelScale[1], modelScale[2], color);
}
