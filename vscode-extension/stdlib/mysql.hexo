import "stdlib/json.hexo" as json;
import "stdlib/tabular.hexo" as tabular;

// MariaDB / MySQL Connector-C driver. SQL statement handles must be closed.
// Use prepared statements for all values that originate outside trusted source.
let open = mysqlOpen;
let openTLS = mysqlOpenTLS;
let close = mysqlClose;
let exec = mysqlExec;
let query = mysqlQuery;
let error = mysqlError;
let prepare = mysqlPrepare;
let bindInt = mysqlStmtBindInt;
let bindFloat = mysqlStmtBindFloat;
let bindText = mysqlStmtBindText;
let bindNull = mysqlStmtBindNull;
fn bindBool(statement, index, value) {
    return bindInt(statement, index, int(bool(value)));
}
let executeStatement = mysqlStmtExecute;
let queryStatement = mysqlStmtQuery;
let closeStatement = mysqlStmtClose;

fn begin(db) { return exec(db, "START TRANSACTION"); }
fn commit(db) { return exec(db, "COMMIT"); }
fn rollback(db) { return exec(db, "ROLLBACK"); }

fn transaction(db, callback) {
    begin(db);
    try {
        let value = callback();
        commit(db);
        return value;
    } catch (errorValue) {
        rollback(db);
        throw errorValue;
    }
}


let execute = exec;
let all = query;
let rows = tabular.rows;
let columns = tabular.columns;

fn first(db, sql) {
    let data = rows(query(db, sql));
    if (len(data) == 0) { return nil; }
    return data[0];
}

fn scalar(db, sql) {
    let row = first(db, sql);
    if (row == nil || len(row) == 0) { return nil; }
    return row[0];
}

fn withTransaction(db, callback) { return transaction(db, callback); }

fn withConnection(host, user, password, database, callback) {
    let db = open(host, user, password, database);
    try {
        let value = callback(db);
        close(db);
        return value;
    } catch (errorValue) {
        close(db);
        throw errorValue;
    }
}


// Type-aware prepared-statement helpers. Each batch statement is finalized promptly.
fn bindValue(statement, index, value) {
    if (value == nil) { return bindNull(statement, index); }
    let kind = typeof(value);
    if (kind == "bool") { return bindBool(statement, index, value); }
    if (kind == "int") { return bindInt(statement, index, value); }
    if (kind == "float") { return bindFloat(statement, index, value); }
    if (kind == "string") { return bindText(statement, index, value); }
    throw "mysql.bindValue supports nil, bool, int, float and string";
}

fn bindValues(statement, values) {
    if (typeof(values) != "array") { throw "mysql.bindValues expects an array"; }
    for (let i in range(0, len(values))) { bindValue(statement, i + 1, values[i]); }
    return statement;
}

fn executePrepared(db, sql, values = []) {
    let statement = prepare(db, sql);
    try {
        bindValues(statement, values);
        let result = executeStatement(statement);
        closeStatement(statement);
        return result;
    } catch (errorValue) {
        try { closeStatement(statement); } catch (ignored) { }
        throw errorValue;
    }
}

fn queryPrepared(db, sql, values = []) {
    let statement = prepare(db, sql);
    try {
        bindValues(statement, values);
        let result = queryStatement(statement);
        closeStatement(statement);
        return result;
    } catch (errorValue) {
        try { closeStatement(statement); } catch (ignored) { }
        throw errorValue;
    }
}

fn executeMany(db, sql, batches) {
    if (typeof(batches) != "array") { throw "mysql.executeMany expects an array of parameter arrays"; }
    return transaction(db, fn () {
        let count = 0;
        for (let values in batches) { executePrepared(db, sql, values); count = count + 1; }
        return count;
    });
}

fn queryObjects(db, sql, values = []) {
    let result = queryPrepared(db, sql, values);
    let names = tabular.columns(result);
    let output = [];
    for (let row in tabular.rows(result)) {
        let item = json.object();
        for (let i in range(0, len(names))) { json.set(item, names[i], row[i]); }
        output.push(item);
    }
    return output;
}

fn withConnectionTLS(host, user, password, database, port, ca, cert, key, callback) {
    let db = openTLS(host, user, password, database, port, ca, cert, key);
    try {
        let value = callback(db);
        close(db);
        return value;
    } catch (errorValue) {
        close(db);
        throw errorValue;
    }
}
