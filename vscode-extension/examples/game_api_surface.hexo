import "stdlib/game.hexo" as game;
import "stdlib/simple_game.hexo" as simple;
import "stdlib/game_3d.hexo" as game3d;
import "stdlib/simple_game3d.hexo" as simple3d;

assert(typeof(game.loadBMP) == "function");
assert(typeof(game.drawTexture) == "function");
assert(typeof(game.controllerCount) == "function");
assert(typeof(game.controllerButton) == "function");
assert(typeof(simple.drawTriangle) == "function");
assert(typeof(simple.drawEllipse) == "function");
assert(typeof(simple.drawLineEx) == "function");
assert(typeof(simple.drawRectangleRounded) == "function");
assert(typeof(simple.withCamera2D) == "function");
assert(typeof(simple.initAudioDevice) == "function");
assert(typeof(simple.loadSound) == "function");
assert(typeof(simple.pauseSound) == "function");
assert(typeof(simple.resumeSound) == "function");
assert(typeof(simple.setSoundPan) == "function");
assert(typeof(simple.loadMusicStream) == "function");
assert(typeof(simple.seekMusicStream) == "function");
assert(typeof(simple.setMusicPitch) == "function");
assert(typeof(simple.setMusicPan) == "function");
assert(typeof(simple.setMasterVolume) == "function");
assert(typeof(simple.loadFont) == "function");
assert(typeof(simple.drawTextEx) == "function");
assert(typeof(simple.measureTextEx) == "function");
assert(typeof(simple.loadRenderTexture) == "function");
assert(typeof(simple.beginTextureMode) == "function");
assert(typeof(simple.drawRenderTexture) == "function");
assert(typeof(simple.isGamepadAvailable) == "function");
assert(typeof(simple.isGamepadButtonDown) == "function");
assert(typeof(simple.getGamepadAxisMovement) == "function");
assert(typeof(simple.getGamepadName) == "function");
assert(typeof(simple.isMouseButtonDown) == "function");
assert(typeof(game3d.drawPlane) == "function");
assert(typeof(game3d.drawCubeWires) == "function");
assert(typeof(game3d.drawSphereWires) == "function");
assert(typeof(game3d.drawCylinder) == "function");
assert(typeof(game3d.loadModel) == "function");
assert(typeof(game3d.drawModel) == "function");
assert(typeof(game3d.drawModelEx) == "function");
assert(typeof(game3d.drawModelWires) == "function");
assert(typeof(game3d.drawModelWiresEx) == "function");
assert(typeof(simple3d.drawCylinder) == "function");
assert(typeof(simple3d.drawModelEx) == "function");
assert(typeof(simple3d.drawModelWires) == "function");
assert(typeof(simple3d.drawModelWiresEx) == "function");
print("game API surface OK");
