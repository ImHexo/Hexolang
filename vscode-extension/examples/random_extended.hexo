import "stdlib/random.hexo" as random;
import "stdlib/math.hexo" as math;
random.seed(12345);
assert(random.uniform(2, 2) == 2);
assert(random.chance(1));
assert(!random.chance(0));
assert(random.boolean() == true || random.boolean() == false);
let shuffled = random.shuffle([1, 2, 3, 4]);
assert(len(shuffled) == 4);
assert(shuffled.sort().join(",") == "1,2,3,4");
let picked = random.sample([1, 2, 3, 4], 2);
assert(len(picked) == 2);
assert(random.weightedChoice(["a"], [1]) == "a");
assert(math.isEven(8));
assert(math.isOdd(9));
assert(math.factorial(5) == 120);
assert(math.gcd(18, 24) == 6);
assert(math.lcm(6, 8) == 24);
assert(math.distance2D(0, 0, 3, 4) == 5);
assert(math.smoothstep(0, 1, 0) == 0);
assert(math.wrap(-1, 0, 10) == 9);
assert(math.trunc(-2.9) == -2);
print("extended random and math OK");
