let drawLineEx = simpleGameDrawLineEx;
let drawRectangleRounded = simpleGameDrawRectRounded;
let measureText = simpleGameTextWidth;
let beginMode2D = simpleGameBegin2D;
let endMode2D = simpleGameEnd2D;
fn withCamera2D(camera, drawCallback) {
    beginMode2D(camera.offset[0], camera.offset[1], camera.target[0], camera.target[1], camera.rotation, camera.zoom);
    try {
        let result = drawCallback();
        endMode2D();
        return result;
    } catch (errorValue) {
        endMode2D();
        throw errorValue;
    }
}
class Camera2D {
    fn init(offset, target, rotation = 0, zoom = 1) {
        this.offset = offset; this.target = target; this.rotation = rotation; this.zoom = zoom;
    }
}


