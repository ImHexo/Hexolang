const BLACK = 0x000000;
const WHITE = 0xffffff;
const RED = 0xff0000;
const GREEN = 0x00ff00;
const BLUE = 0x0000ff;
const YELLOW = 0xffff00;
const GRAY = 0x808080;


fn colorRGB(r, g, b) { return int(r) * 65536 + int(g) * 256 + int(b); }
fn colorRGBA(r, g, b, a) { return int(a) * 16777216 + colorRGB(r, g, b); }
fn drawRectangleV(position, size, color) {
    return drawRectangle(position[0], position[1], size[0], size[1], color, true);
}
fn drawRectangleLines(x, y, width, height, color) {
    return drawRectangle(x, y, width, height, color, false);
}
fn drawLineV(start, finish, color) {
    return drawLine(start[0], start[1], finish[0], finish[1], color);
}
fn drawCircleV(center, radius, color, filled = nil) {
    if (filled == nil) { filled = true; }
    return drawCircle(center[0], center[1], radius, color, filled);
}
fn drawTextureAt(texture, position, tint = nil) {
    if (tint == nil) { return drawTexture(texture, position[0], position[1]); }
    return drawTexture(texture, position[0], position[1], tint);
}
fn keyDown(keyCode) { return isKeyDown(keyCode); }
fn keyPressed(keyCode) { return isKeyPressed(keyCode); }


// Common 2D math and collision helpers; these work without a raylib window.
fn vec2(x, y) { return [x, y]; }
fn add(a, b) { return [a[0] + b[0], a[1] + b[1]]; }
fn subtract(a, b) { return [a[0] - b[0], a[1] - b[1]]; }
fn scale(a, amount) { return [a[0] * amount, a[1] * amount]; }
fn dot(a, b) { return a[0] * b[0] + a[1] * b[1]; }
fn length(a) { return sqrt(dot(a, a)); }
fn normalize(a) {
    let magnitude = length(a);
    if (magnitude == 0) { return [0, 0]; }
    return scale(a, 1 / magnitude);
}
fn distance(a, b) { return length(subtract(a, b)); }
fn lerp(a, b, amount) { return add(a, scale(subtract(b, a), amount)); }
fn rectContains(rect, point) {
    return point[0] >= rect[0] && point[1] >= rect[1] &&
        point[0] <= rect[0] + rect[2] && point[1] <= rect[1] + rect[3];
}
fn rectIntersects(a, b) {
    return a[0] < b[0] + b[2] && a[0] + a[2] > b[0] &&
        a[1] < b[1] + b[3] && a[1] + a[3] > b[1];
}
fn circlesIntersect(a, radiusA, b, radiusB) {
    let radii = radiusA + radiusB;
    return dot(subtract(a, b), subtract(a, b)) <= radii * radii;
}


