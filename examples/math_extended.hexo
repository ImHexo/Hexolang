import "stdlib/math.hexo" as math;
assert(math.abs(-3) == 3);
assert(math.sin(math.PI / 2.0) > 0.999999);
assert(math.cos(0.0) > 0.999999);
assert(math.hypot(3.0, 4.0) == 5.0);
assert(math.toDegrees(math.PI) > 179.999);
assert(math.clamp(12, 0, 10) == 10);
assert(math.lerp(0, 10, 0.25) == 2.5);
print("extended math OK", math.log10(1000), math.atan2(1, 1));
