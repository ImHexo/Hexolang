import "stdlib/mysql.hexo" as mysql;
import "stdlib/mariadb.hexo" as mariadb;
assert(typeof(mysql.open) == "function");
assert(typeof(mysql.openTLS) == "function");
assert(typeof(mysql.bindBool) == "function");
assert(typeof(mysql.withConnection) == "function");
assert(typeof(mysql.bindValue) == "function");
assert(typeof(mysql.bindValues) == "function");
assert(typeof(mysql.executePrepared) == "function");
assert(typeof(mysql.queryPrepared) == "function");
assert(typeof(mysql.executeMany) == "function");
assert(typeof(mysql.queryObjects) == "function");
assert(typeof(mysql.withConnectionTLS) == "function");
assert(typeof(mariadb.open) == "function");
assert(typeof(mariadb.openTLS) == "function");
assert(typeof(mariadb.bindBool) == "function");
assert(typeof(mariadb.bindValue) == "function");
assert(typeof(mariadb.executeMany) == "function");
assert(typeof(mariadb.queryObjects) == "function");
assert(typeof(mariadb.withConnectionTLS) == "function");
print("MySQL/MariaDB client modules OK");
